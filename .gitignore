# Dependencies
node_modules/
yarn.lock
# package-lock.json is deliberately NOT ignored. It pins the exact dependency
# versions, so a deploy installs what was tested rather than whatever is newest
# that day — which is also the main defence against a compromised package
# release reaching production.

# Environment / Secrets
.env
.env.local
.env.*.local
*.pem

# Build output
dist/
build/
.next/
out/

# Logs
*.log
npm-debug.log*

# OS / Editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Database
*.sqlite
*.db
