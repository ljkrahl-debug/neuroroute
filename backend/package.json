{
  "name": "neuroroute-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Neuroroute API — multimodal logistics platform (Phase 1: auth + core flow)",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "migrate": "node db/migrate.js",
    "seed": "node scripts/seed.js",
    "check:deploy": "node scripts/check-deploy.js",
    "test": "node --test --test-concurrency=1 \"tests/*.test.js\"",
    "test:setup": "node db/migrate.js --reset"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  }
}
