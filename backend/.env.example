# Copy to .env and adjust. .env is gitignored — never commit real credentials.

NODE_ENV=development
PORT=3000

# PostgreSQL. docker-compose.yml brings up a matching instance.
# On Railway this comes from the Postgres service: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://neuroroute:neuroroute@localhost:5432/neuroroute_dev

# TLS to the database: auto | disable | require | no-verify
#   auto      no TLS on Railway's private network, TLS everywhere else in production
#   no-verify TLS without verifying the certificate — needed for Railway's public
#             database proxy, which presents a self-signed certificate. Prefer the
#             private network (*.railway.internal) and leave this on auto.
DATABASE_SSL=auto

# Where the browser app runs. Cookie auth means the origin has to be listed
# explicitly — a wildcard cannot be combined with credentials.
# Comma-separated for more than one. In production these must be https.
CORS_ORIGINS=http://localhost:5173

# --- Session cookie ---------------------------------------------------------
# Only needed when the API and the web app are on different subdomains of the
# same site, e.g. app on neuroroute.com and API on api.neuroroute.com:
# COOKIE_DOMAIN=.neuroroute.com
#
# lax (default) is right whenever the two share a site. Use none ONLY if the API
# genuinely cannot live on a subdomain of the app — it needs HTTPS and some
# browsers restrict third-party cookies anyway.
# COOKIE_SAMESITE=lax
#
# The public URL of this API. Not used at runtime; it lets the startup check
# notice when the API and the app are on different sites and the session cookie
# would silently never be sent.
# PUBLIC_API_ORIGIN=https://api.neuroroute.com

# Companies must be verified by an admin before they can post requests or
# offers. Set to false locally to skip the verification step while developing.
REQUIRE_VERIFIED_COMPANY=true

# Login throttling (per IP + email).
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_MS=900000

# Only read by scripts/seed.js and scripts/create-admin.js.
# SEED_PASSWORD=neuroroute-demo-2026
# ADMIN_PASSWORD=
