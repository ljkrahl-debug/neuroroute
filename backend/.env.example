# Copy to .env and adjust. .env is gitignored — never commit real credentials.

NODE_ENV=development
PORT=3000

# PostgreSQL. docker-compose.yml brings up a matching instance.
DATABASE_URL=postgres://neuroroute:neuroroute@localhost:5432/neuroroute_dev

# Where the browser app runs. Cookie auth means the origin has to be listed
# explicitly — a wildcard cannot be combined with credentials.
# Comma-separated for more than one.
CORS_ORIGINS=http://localhost:5173

# Companies must be verified by an admin before they can post requests or
# offers. Set to false locally to skip the verification step while developing.
REQUIRE_VERIFIED_COMPANY=true

# Login throttling (per IP + email).
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_MS=900000

# Only read by scripts/seed.js and scripts/create-admin.js.
# SEED_PASSWORD=neuroroute-demo-2026
# ADMIN_PASSWORD=
